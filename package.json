{
  "name": "dsh-computer-use",
  "description": "Computer Use plugin for DSH: AI agents can control the desktop via screenshot, mouse, keyboard, and window management tools. Powered by xdotool, ImageMagick, and xclip.",
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Febloodfightying/dsh-computer-use.git"
  },
  "bugs": {
    "url": "https://github.com/Febloodfightying/dsh-computer-use/issues"
  },
  "homepage": "https://github.com/Febloodfightying/dsh-computer-use#readme",
  "license": "MIT"
}
